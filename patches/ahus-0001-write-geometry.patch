+def save_geometry_json(
+    got_values: dict[str, Any],
+    output_basepath: str,
+    original_hw: tuple[int, int],
+    inference_wrapper: Any,
+) -> None:
+    """Persist the geometric provenance needed to map canonical sample index
+    back to original image pixels (F4-c: image-evidence time axis)."""
+    source_points = got_values["source_points"].cpu()
+    aligned_hw = tuple(int(v) for v in got_values["aligned"]["image"].shape[-2:])
+    resampled_hw = tuple(int(v) for v in got_values["input_image"].shape[-2:])
+    destination_points = inference_wrapper.cropper._calculate_destination_points(
+        aligned_hw[0], aligned_hw[1], source_points
+    )
+    orig_h, orig_w = int(original_hw[0]), int(original_hw[1])
+    geometry = {
+        "source_points": [list(map(float, p)) for p in source_points.tolist()],
+        "destination_points": [list(map(float, p)) for p in destination_points.tolist()],
+        "original_size": [orig_w, orig_h],
+        "resampled_size": [resampled_hw[1], resampled_hw[0]],
+        "resample_scale": resampled_hw[1] / orig_w,
+        "aligned_size": [aligned_hw[1], aligned_hw[0]],
+        "valid_span": got_values.get("signal", {}).get("valid_span"),
+        "target_num_samples": getattr(inference_wrapper.identifier, "target_num_samples", None),
+        "apply_dewarping": bool(getattr(inference_wrapper, "apply_dewarping", False)),
+    }
+    with open(output_basepath + "_geometry.json", "w", encoding="utf-8") as f:
+        json.dump(geometry, f)
+
